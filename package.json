{
  "name": "@ibintec/aftereffects-mcp",
  "version": "1.0.0-ibintec.1",
  "private": true,
  "description": "Ibintec After Effects MCP: lets AI clients such as Claude Desktop build, animate and see After Effects compositions. Based on after-effects-mcp by Dakkshin (MIT).",
  "author": "Ibintec Limited",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ibintec/aftereffects-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/ibintec/aftereffects-mcp/issues"
  },
  "homepage": "https://github.com/ibintec/aftereffects-mcp#readme",
  "main": "build/index.js",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --format=esm --outfile=build/index.js --packages=external && copyfiles -u 1 \"src/scripts/**/*\" build",
    "start": "node build/index.js",
    "install-bridge": "node install-bridge.js",
    "postinstall": "npm run build"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.28.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.17.30",
    "copyfiles": "^2.4.1",
    "esbuild": "^0.27.4",
    "typescript": "^5.2.2"
  }
}
